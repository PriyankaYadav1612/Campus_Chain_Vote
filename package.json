{
  "name": "campus-chain-vote",
  "version": "1.0.0",
  "description": "Tamper-proof campus voting (hybrid blockchain app)",
  "scripts": {
    "compile": "hardhat compile",
    "test:contract": "hardhat test",
    "test:backend": "npm --prefix backend test",
    "test": "hardhat test && npm --prefix backend test",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "seed": "npm --prefix backend run seed && hardhat run scripts/seed-chain.js --network localhost",
    "tamper-demo": "node scripts/tamper-demo.js",
    "setup": "node scripts/setup.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.1.0",
    "@prisma/client": "^7.10.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^4.5.0",
    "concurrently": "^9.1.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.18",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^7.0.2"
  }
}
